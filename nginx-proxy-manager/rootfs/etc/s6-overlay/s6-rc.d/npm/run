#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Nginx Proxy Manager
# Runs the nginx proxy manager interface
# ==============================================================================
declare -a options

bashio::log.info "Starting the Manager..."

options+=(--abort_on_uncaught_exception)
options+=("--max_old_space_size=250")

export NODE_ENV=production

# Upstream reads the certbot version from the environment since v2.13.0,
# and uses it to pin the DNS plugins it installs.
CERTBOT_VERSION="$(certbot --version 2>&1 | grep -Eo '[0-9](\.[0-9]+)+')"
export CERTBOT_VERSION

cd /opt/nginx-proxy-manager \
    || bashio::exit.nok "Could not change directory to app"

exec node "${options[@]}" /opt/nginx-proxy-manager/index.js
