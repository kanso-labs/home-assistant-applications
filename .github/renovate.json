{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": ["ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s"]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "{{{datasource}}}",
      "description": "Application versions, annotated above their ARG in each Dockerfile",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "datasourceTemplate": "{{{datasource}}}",
      "description": "Application versions supplied as distribution packages, annotated above their ARG",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{{versioning}}}"
    }
  ],
  "extends": ["config:recommended"],
  "minimumReleaseAge": null,
  "mise": {
    "enabled": true
  },
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "allowedVersions": "<3.14",
      "description": "Bazarr supports Python 3.13 and below, and says so on startup when it is given anything newer. It is the only application on base-python, so the ceiling can sit on the image itself.",
      "matchPackageNames": ["ghcr.io/home-assistant/base-python"]
    },
    {
      "groupName": "Home Assistant Base Images",
      "matchPackageNames": ["ghcr.io/home-assistant/**"]
    },
    {
      "description": "Bumping the application a container runs is what users see, so it has to reach them. release-please only cuts a release for fix and feat, and it attributes a commit to an application by the files that commit touches.",
      "matchDepNames": [
        "Jackett/Jackett",
        "Notifiarr/notifiarr",
        "Prowlarr/Prowlarr",
        "Radarr/Radarr",
        "Sonarr/Sonarr",
        "Unpackerr/unpackerr",
        "alpine_3_24/qbittorrent-nox",
        "ghcr.io/flaresolverr/flaresolverr",
        "ghcr.io/seerr-team/seerr",
        "jjdenhertog/spotify-to-plex",
        "morpheus65535/bazarr",
        "n8n",
        "nzbgetcom/nzbget",
        "plexinc/pms-docker"
      ],
      "semanticCommitType": "fix"
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "always",
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
