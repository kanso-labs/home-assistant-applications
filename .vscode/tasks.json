{
  "inputs": [
    {
      "description": "Name of application (to add your application to this list, please edit .vscode/tasks.json)",
      "id": "appName",
      "options": ["n8n"],
      "type": "pickString"
    }
  ],
  "tasks": [
    {
      "command": "supervisor_run",
      "group": {
        "isDefault": true,
        "kind": "test"
      },
      "label": "Start Home Assistant",
      "presentation": {
        "panel": "new",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "ha apps install \"local_${input:appName}\"",
      "group": {
        "isDefault": false,
        "kind": "test"
      },
      "label": "Install application",
      "presentation": {
        "panel": "new",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "ha apps stop \"local_${input:appName}\"; ha apps start \"local_${input:appName}\"; ha apps logs -f \"local_${input:appName}\"",
      "group": {
        "isDefault": false,
        "kind": "test"
      },
      "label": "Start application",
      "presentation": {
        "panel": "new",
        "reveal": "always"
      },
      "problemMatcher": [],
      "runOptions": {
        "reevaluateOnRerun": false
      },
      "type": "shell"
    },
    {
      "command": "ha apps rebuild --force \"local_${input:appName}\"; ha apps start \"local_${input:appName}\"; ha apps logs -f \"local_${input:appName}\"",
      "group": {
        "isDefault": false,
        "kind": "test"
      },
      "label": "Rebuild and start application",
      "presentation": {
        "panel": "new",
        "reveal": "always"
      },
      "problemMatcher": [],
      "type": "shell"
    }
  ],
  "version": "2.0.0"
}
