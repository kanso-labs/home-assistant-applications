#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Spotify to Plex
# Puts the application's options into the environment, then starts it
# ==============================================================================

readonly key_file='/config/.encryption_key'

# The application keeps everything it stores in one directory, chosen by this
# variable. Left alone it writes inside the image, where an update discards it.
export STORAGE_DIR='/config'

# Home Assistant mounts this, so it is normally already here. Creating it makes
# the key below writable even when it is not, rather than failing on the first
# line that touches it.
mkdir -p "${STORAGE_DIR}"

# The key encrypts the credentials the application stores. Generating it once
# and keeping it beside them is what lets them still be read after a restart:
# a new key would leave the stored credentials unreadable.
#
# It has to be the 64 hexadecimal characters of a 32-byte aes-256-cbc key,
# which is what the project's installation instructions ask for and what
# `openssl rand -hex 32` writes. The application reads the variable as
# `Buffer.from(key, 'hex')`, and Node's hex decoder stops at the first
# character it cannot read rather than reporting anything, so a key in any
# other encoding decodes to a buffer too short to use. Nothing says so until a
# credential is first encrypted, which fails with `invalid_key_length` — when
# adding a Spotify user, in practice.
#
# Upper case passes the check below as well as lower. `openssl` writes lower,
# but the decoder reads either, so a key put here by hand is as usable as a
# generated one and replacing it would throw away credentials that can still
# be read.
#
# Earlier versions of this application wrote base64 here, which never decoded
# to a usable key, so no credential was ever encrypted with one. Replacing such
# a file therefore loses nothing that was readable to begin with.
if bashio::fs.file_exists "${key_file}" \
  && [[ ! "$(<"${key_file}")" =~ ^[0-9a-fA-F]{64}$ ]]; then
  bashio::log.warning 'The stored encryption key is not 64 hexadecimal'
  bashio::log.warning 'characters, so the application cannot use it.'
  bashio::log.warning 'Replacing it. Anything already connected has to be'
  bashio::log.warning 'connected again from the interface.'
  rm -f "${key_file}"
fi

if ! bashio::fs.file_exists "${key_file}"; then
  bashio::log.info 'Generating an encryption key for stored credentials...'
  openssl rand -hex 32 | tr -d '\n' > "${key_file}"
  chmod 600 "${key_file}"
fi

ENCRYPTION_KEY="$(<"${key_file}")"
export ENCRYPTION_KEY

# Identifies this application to Plex when authorising. It is the value the
# project publishes, so authorisations issued here look the way Plex expects.
export PLEX_APP_ID='eXf+f9ktw3CZ8i45OY468WxriOCtoFxuNPzVeDcAwfw='

# Spotify sends the browser back here after sign-in, and requires the address
# to be reachable over HTTPS, which rules out a Home Assistant instance on a
# private one. This page receives the redirect and forwards it to whichever
# instance started the sign-in.
#
# It is served from this repository so the application does not depend on a
# page hosted elsewhere staying where it is. The option exists for anyone who
# would rather host it themselves, and has to match what is registered with
# Spotify either way.
if bashio::config.has_value 'redirect_uri'; then
  SPOTIFY_API_REDIRECT_URI="$(bashio::config 'redirect_uri')"
else
  SPOTIFY_API_REDIRECT_URI='https://kanso-labs.github.io/home-assistant-applications/spotify-to-plex/callback.html'
fi
export SPOTIFY_API_REDIRECT_URI

bashio::log.info "Redirect URI: ${SPOTIFY_API_REDIRECT_URI}"

# Exported only when set. An empty value reads as configured to the
# application, so an unset option has to leave the variable absent instead.
if bashio::config.has_value 'spotify_client_id'; then
  SPOTIFY_API_CLIENT_ID="$(bashio::config 'spotify_client_id')"
  export SPOTIFY_API_CLIENT_ID
fi

if bashio::config.has_value 'spotify_client_secret'; then
  SPOTIFY_API_CLIENT_SECRET="$(bashio::config 'spotify_client_secret')"
  export SPOTIFY_API_CLIENT_SECRET
fi

if bashio::config.has_value 'spotify_client_id' \
  && bashio::config.has_value 'spotify_client_secret'; then
  bashio::log.info 'Spotify credentials found.'
else
  bashio::log.notice 'No Spotify credentials set. The interface will start,'
  bashio::log.notice 'but it cannot reach Spotify until an application is'
  bashio::log.notice 'created at developer.spotify.com and its client id and'
  bashio::log.notice 'secret are added to the application options.'
fi

exec /docker-entrypoint.sh "$@"
