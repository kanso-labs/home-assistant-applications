#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Scrutiny
# Runs the InfluxDB that Scrutiny keeps its S.M.A.R.T. history in
# ==============================================================================
readonly data_dir='/data/influxdb'

mkdir -p "${data_dir}"

# Written on every start, so a change here reaches existing installs too.
# InfluxDB listens on the loopback address alone: Scrutiny sets it up with a
# fixed token that is published in its source, so nothing else on Home
# Assistant's network may reach it.
cat > "${data_dir}/config.yaml" <<EOF
bolt-path: ${data_dir}/influxd.bolt
engine-path: ${data_dir}/engine
http-bind-address: 127.0.0.1:8086
reporting-disabled: true
EOF

export INFLUXD_CONFIG_PATH="${data_dir}"

bashio::log.info 'Starting InfluxDB...'

exec influxd run
