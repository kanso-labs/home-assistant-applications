#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Flight Finder
# Runs Flight Finder
# ==============================================================================
readonly database='flight_finder'
readonly socket_dir='/run/postgresql'
readonly secrets='/data/secrets'

# s6 starts this service as soon as PostgreSQL's service has started, which is
# not the same as PostgreSQL being ready to answer, and the role and the
# database have to exist before Flight Finder can reach them. After an unclean
# stop PostgreSQL first replays its log, which on slow storage takes far longer
# than a normal start, so the wait is long and says where it is.
bashio::log.info 'Waiting for PostgreSQL...'
for ((waited = 1; waited <= 600; waited++)); do
  pg_isready --host="${socket_dir}" --username='postgres' --quiet && break
  if ((waited % 30 == 0)); then
    bashio::log.info "Still waiting for PostgreSQL after ${waited} seconds..."
  fi
  sleep 1
done
pg_isready --host="${socket_dir}" --username='postgres' --quiet \
  || bashio::exit.nok 'PostgreSQL did not become ready'

if ! s6-setuidgid postgres psql --host="${socket_dir}" --username='postgres' \
    --no-align --tuples-only \
    --command="SELECT 1 FROM pg_database WHERE datname = '${database}'" \
    | grep -q 1; then
  bashio::log.info 'Creating the Flight Finder database...'
  s6-setuidgid postgres createuser --host="${socket_dir}" "${database}"
  s6-setuidgid postgres createdb --host="${socket_dir}" --owner="${database}" "${database}"
fi

export DATABASE_URL="postgresql://${database}@127.0.0.1:5432/${database}"

# Flight Finder keeps its rate limits in Valkey. Whenever it cannot reach it,
# the limit on failed sign-ins lets every attempt through and the search bar's
# previews are all refused, so it does not start until Valkey answers.
bashio::log.info 'Waiting for Valkey...'
for _ in {1..30}; do
  valkey-cli -h 127.0.0.1 -p 6379 ping > /dev/null 2>&1 && break
  sleep 1
done
valkey-cli -h 127.0.0.1 -p 6379 ping > /dev/null 2>&1 \
  || bashio::exit.nok 'Valkey did not become ready'

export REDIS_URL='redis://127.0.0.1:6379'

# Upstream's entrypoint generates both secrets afresh on every start unless
# they are given. ADMIN_SESSION_SECRET is the one that matters: the API keys
# saved in Flight Finder's settings are encrypted with a key derived from it, so
# a new one on every start would make them unreadable. Generating the secrets
# once and keeping them in /data is what makes them survive a restart.
mkdir -p "${secrets}"
chmod 0700 "${secrets}"
for secret in admin_session_secret cron_secret; do
  if [[ ! -s "${secrets}/${secret}" ]]; then
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "${secrets}/${secret}"
    chmod 0600 "${secrets}/${secret}"
  fi
done
ADMIN_SESSION_SECRET="$(<"${secrets}/admin_session_secret")"
CRON_SECRET="$(<"${secrets}/cron_secret")"
export ADMIN_SESSION_SECRET CRON_SECRET

# Flight Finder before 0.16 was started with an admin password, which this
# application generated and kept here. Nothing reads it any more.
rm -f "${secrets}/admin_password"

# Flight Finder lets nobody in until its first Admin profile and shared password
# exist, and upstream creates them with a command that asks for both at a
# terminal. flight-finder-access creates them from the options instead, once
# Flight Finder is up. A password Flight Finder would refuse stops the start
# here, rather than leaving it at a setup page nobody can get past.
if bashio::config.has_value 'access_password'; then
  password="$(bashio::config 'access_password')"
  if (( ${#password} < 12 )); then
    bashio::exit.nok 'The shared password needs at least 12 characters'
  fi
  unset password
fi

# Flight Finder signs people in only at addresses it was told about, and turns
# away any other with "This address is not configured for login". It is told
# the addresses Home Assistant's Open Web UI button leads to, which are this
# machine's name and IPv4 addresses on the port Flight Finder is published on,
# as upstream's installer tells it the computer's. The options add the rest,
# such as a reverse proxy's.
addresses=()
for address in $(bashio::config 'addresses'); do
  address="${address%/}"
  if [[ ! "${address}" =~ ^https?://(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+)(:[0-9]{1,5})?$ ]]; then
    bashio::exit.nok "Flight Finder takes an address as a scheme, a host and a port alone, such as https://flights.example.com, so it cannot use ${address}"
  fi
  addresses+=("${address}")
done

port="$(bashio::app.port '3003/tcp')"
if bashio::var.has_value "${port}"; then
  host_name="$(bashio::info.hostname)"
  if [[ "${host_name}" =~ ^[A-Za-z0-9-]+$ ]]; then
    addresses+=("http://${host_name}.local:${port}" "http://${host_name}:${port}")
  fi
  # Supervisor answers with an error on a host whose network it cannot read,
  # which would be logged on every start. The options can still name these.
  for ip in $( (bashio::log.level 'fatal'; bashio::network.ipv4_address) || true); do
    ip="${ip%%/*}"
    if [[ "${ip}" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
      addresses+=("http://${ip}:${port}")
    fi
  done
fi

# The main address is the one Flight Finder's alerts link to, and the only one
# passkeys work at, which they do only over HTTPS. Behind a reverse proxy it
# is also what lets Flight Finder trust the proxy's account of the address the
# browser asked for. So the first HTTPS address is the main one, if any is.
# Every address goes in the list as well, because an address saved in Flight
# Finder's own settings takes the main one's place.
if (( ${#addresses[@]} > 0 )); then
  APP_URL="${addresses[0]}"
  for address in "${addresses[@]}"; do
    if [[ "${address}" == https://* ]]; then
      APP_URL="${address}"
      break
    fi
  done
  SIDEDOOR_PASSWORD_ORIGINS="$(printf '%s\n' "${addresses[@]}" | jq -R . | jq -c -s 'unique')"
  export APP_URL SIDEDOOR_PASSWORD_ORIGINS
  bashio::log.info "Flight Finder accepts sign-ins at $(jq -r 'join(", ")' <<< "${SIDEDOOR_PASSWORD_ORIGINS}")"
  bashio::log.info "Its main address is ${APP_URL}"
else
  bashio::log.warning 'Flight Finder is published on no port and no other address is set, so it accepts sign-ins nowhere. Set one in the Configuration tab.'
fi

# The Claude Code and Codex CLIs are left out. Their logins can only be copied
# in from a computer's home directory, which a Home Assistant application has
# no way to reach, and upstream's step that prunes old CLI versions refuses to
# run unless its entrypoint is the only thing running in the container, which
# PostgreSQL here never lets it be.
export INSTALL_CLI_PROVIDERS='false'

# The price history outside PostgreSQL. The image links /app/data to it.
mkdir -p /data/app
chown node:node /data/app

# Upstream derives this path from the working directory unless it is given,
# which is inside the image rather than on /data.
export ANALYTICS_DB_PATH='/app/data/analytics.db'

# s6-setuidgid changes the user without changing the home directory.
export HOME='/home/node'
export USER='node'

cd /app || bashio::exit.nok 'Flight Finder is missing from the image'

# In the background, with the environment Flight Finder starts with, so that it
# reaches the same database. It waits for Flight Finder to answer, because the
# commands it runs need the database upstream's entrypoint prepares first. The
# outer subshell exits at once, so the init process reaps it rather than
# Flight Finder's server, which never would.
( flight-finder-access & )

bashio::log.info 'Starting Flight Finder...'

exec s6-setuidgid node ./docker-entrypoint.sh
