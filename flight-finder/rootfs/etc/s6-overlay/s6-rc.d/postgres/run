#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Flight Finder
# Runs the PostgreSQL that Flight Finder stores everything in
# ==============================================================================

# The major version the image installs, which the Dockerfile names as well, in
# its postgresql17 packages, so moving to another one means changing both.
readonly pg_major='17'

readonly data_dir='/data/postgresql'
readonly socket_dir='/run/postgresql'

mkdir -p "${socket_dir}"
chown postgres:postgres "${socket_dir}"

# /data is where Home Assistant keeps an application's private state and is
# included in backups, which is what makes this the database's home.
if [[ ! -s "${data_dir}/PG_VERSION" ]]; then
  bashio::log.info 'Creating the PostgreSQL cluster...'

  mkdir -p "${data_dir}"
  chown postgres:postgres "${data_dir}"
  chmod 0700 "${data_dir}"

  # Local connections are trusted because nothing outside this container can
  # make one: the server is told below to listen on the loopback address alone,
  # and no port for it is published in config.yaml.
  s6-setuidgid postgres initdb \
    --pgdata="${data_dir}" \
    --encoding='UTF8' \
    --locale='C.UTF-8' \
    --auth-local='trust' \
    --auth-host='trust' \
    > /dev/null || bashio::exit.nok 'Could not create the PostgreSQL cluster'
fi

# A cluster can only be opened by the major version that created it, so moving
# this application to a new one takes a migration shipped in the same release,
# with both versions installed for pg_upgrade. This is what catches a release
# without one. PostgreSQL would refuse the cluster anyway, but in words that do
# not say what to do.
cluster_major="$(<"${data_dir}/PG_VERSION")"
if [[ "${cluster_major}" != "${pg_major}" ]]; then
  bashio::log.error \
    "The database in ${data_dir} was created by PostgreSQL ${cluster_major}," \
    "and this release runs PostgreSQL ${pg_major}, which cannot open it."
  bashio::log.error \
    'Restore the backup taken before this update, which brings back the' \
    'release that matches the database, and report this on the issue tracker:' \
    'https://github.com/kanso-labs/home-assistant-applications/issues'
  bashio::exit.nok "PostgreSQL ${pg_major} cannot open a PostgreSQL ${cluster_major} database"
fi

chown postgres:postgres "${data_dir}"

bashio::log.info 'Starting PostgreSQL...'

# s6 stops this service with SIGINT, which down-signal sets, rather than its
# default SIGTERM. PostgreSQL takes SIGTERM as a smart shutdown, which waits for
# every client still connected, so a connection left open when Flight Finder
# stops would hold it there until Supervisor kills the container, and the next
# start would replay the log. SIGINT is a fast shutdown, which disconnects them
# and still writes the shutdown checkpoint.
exec s6-setuidgid postgres postgres \
  -D "${data_dir}" \
  -c listen_addresses='127.0.0.1' \
  -c port=5432 \
  -c unix_socket_directories="${socket_dir}"
