#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Immich
# Runs the Valkey that holds Immich's job queue
# ==============================================================================
bashio::log.info 'Starting Valkey...'

# Nothing is saved to disk, so every stop drops the jobs still waiting, and
# Missing under Job Queues in Immich runs them again. Upstream's Valkey saves a
# snapshot inside its container as it stops, so its queue survives a restart;
# see Decision 5 in DOCS.md.
#
# It listens on the loopback address alone, and no port for it is published in
# config.yaml.
exec s6-setuidgid valkey valkey-server \
  --bind 127.0.0.1 \
  --port 6379 \
  --dir /var/lib/valkey \
  --save '' \
  --appendonly no
