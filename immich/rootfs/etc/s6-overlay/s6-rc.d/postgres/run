#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Immich
# Runs the PostgreSQL that Immich keeps everything but the files in
# ==============================================================================

# PGDG keeps the server binaries out of PATH so that several major versions can
# be installed side by side. The image carries clients for 14 to 18, and one
# server.
export PATH="/usr/lib/postgresql/17/bin:${PATH}"

readonly data_dir='/data/postgresql'
readonly socket_dir='/run/postgresql'

mkdir -p "${socket_dir}"
chown postgres:postgres "${socket_dir}"

# /data is where Home Assistant keeps an application's private state and is
# included in backups, which is what makes this the database's home.
if [[ ! -s "${data_dir}/PG_VERSION" ]]; then
  bashio::log.info 'Creating the PostgreSQL cluster...'

  mkdir -p "${data_dir}"
  chown postgres:postgres "${data_dir}"
  chmod 0700 "${data_dir}"

  # Checksums are on, as they are in the database upstream's compose file
  # creates. The access rules initdb writes here go unread: the server takes
  # its rules from the image instead, as it is told below.
  s6-setuidgid postgres initdb \
    --pgdata="${data_dir}" \
    --encoding='UTF8' \
    --locale='C.UTF-8' \
    --auth-local='trust' \
    --auth-host='trust' \
    --data-checksums \
    > /dev/null || bashio::exit.nok 'Could not create the PostgreSQL cluster'
fi

# The postgres user is created when the image is built, with whichever system
# uid is free then, so an update that creates another system user first can
# give it a different one. The files in /data keep the old owner, and
# PostgreSQL then cannot read them. Whatever postgres does not own is handed
# back to it before the server starts. Pinning a uid in the image would not
# help: any uid but the one an install already has fails the same way.
if [[ -n "$(find "${data_dir}" \( ! -user postgres -o ! -group postgres \) -print -quit)" ]]; then
  bashio::log.info 'Giving the PostgreSQL files back to the postgres user...'
  chown -R postgres:postgres "${data_dir}" \
    || bashio::exit.nok 'Could not give the PostgreSQL files to the postgres user'
fi

# Other applications, such as Immich Power Tools, can read the database once a
# read-only password is set. PostgreSQL then listens on Home Assistant's
# internal network too, where its rules admit the reader role alone, by
# password. Without one it listens on the loopback address alone. No port is
# published either way. See DOCS.md.
listen_addresses='127.0.0.1'
if bashio::config.has_value 'database_reader_password'; then
  listen_addresses='*'
fi

bashio::log.info 'Starting PostgreSQL...'

# VectorChord has to be loaded as the server starts. Who may connect, and how,
# is the image's pg_hba.conf.
#
# The rest is the tuning upstream's own database image applies for solid-state
# storage, from its postgresql.ssd.conf. It suits the SD cards and eMMC Home
# Assistant often runs on as well, since none of them seek. The one change is
# shared_buffers, half of upstream's 512MB, because this database shares its
# host with Home Assistant and everything else installed there. max_wal_size
# lets the write-ahead log in /data grow to about 5GB during a large import
# before a checkpoint frees it. Settings given here override any made with
# ALTER SYSTEM.
exec s6-setuidgid postgres postgres \
  -D "${data_dir}" \
  -c listen_addresses="${listen_addresses}" \
  -c port=5432 \
  -c unix_socket_directories="${socket_dir}" \
  -c hba_file='/etc/immich/pg_hba.conf' \
  -c shared_preload_libraries='vchord.so' \
  -c shared_buffers=256MB \
  -c work_mem=16MB \
  -c max_wal_size=5GB \
  -c wal_compression=on \
  -c autovacuum_vacuum_scale_factor=0.1 \
  -c autovacuum_analyze_scale_factor=0.05 \
  -c autovacuum_vacuum_cost_limit=1000 \
  -c effective_io_concurrency=200 \
  -c random_page_cost=1.2
