#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Grimmory
# Runs the MariaDB that Grimmory keeps its library's records in
# ==============================================================================
readonly data_dir='/data/mariadb'
readonly socket_dir='/run/mysqld'

mkdir -p "${socket_dir}"
chown mysql:mysql "${socket_dir}"

# /data is where Home Assistant keeps an application's private state and is
# included in backups, which is what makes this the database's home.
if [[ ! -d "${data_dir}/mysql" ]]; then
  bashio::log.info 'Creating the MariaDB database...'

  mkdir -p "${data_dir}"
  chown mysql:mysql "${data_dir}"
  chmod 0700 "${data_dir}"

  # root signs in over the socket alone, as the operating system's root, which
  # is how the Grimmory service creates its database and user.
  mariadb-install-db \
    --user=mysql \
    --datadir="${data_dir}" \
    --auth-root-authentication-method=socket \
    --skip-test-db \
    > /dev/null || bashio::exit.nok 'Could not create the MariaDB database'
fi

# The mysql user is created when the image is built, with whichever system uid
# is free then, so an update that creates another system user first can give
# it a different one. The files in /data keep the old owner, and MariaDB then
# cannot read them. Whatever mysql does not own is handed to it before the
# server starts. That includes mariadb_upgrade_info, which mariadb-install-db
# leaves to root, so this also happens once after the database is created.
# Pinning a uid in the image would not help: any uid but the one an install
# already has fails the same way.
if [[ -n "$(find "${data_dir}" \( ! -user mysql -o ! -group mysql \) -print -quit)" ]]; then
  bashio::log.info 'Giving the MariaDB files to the mysql user...'
  chown -R mysql:mysql "${data_dir}" \
    || bashio::exit.nok 'Could not give the MariaDB files to the mysql user'
fi

bashio::log.info 'Starting MariaDB...'

# Alpine's configuration turns networking off, and Grimmory connects over TCP.
# MariaDB listens on the loopback address alone, where nothing outside this
# container can reach it, and no port for it is published in config.yaml.
exec s6-setuidgid mysql mariadbd \
  --datadir="${data_dir}" \
  --socket="${socket_dir}/mysqld.sock" \
  --skip-networking=0 \
  --bind-address=127.0.0.1 \
  --port=3306 \
  --skip-name-resolve
