#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Tautulli
# Runs nginx, which answers on 8181 for Tautulli, puts its HTTP root back onto
# requests that arrive without it, and takes it out of what goes back to the
# published port
# ==============================================================================
readonly config_file='/config/config.ini'
readonly servers_dir='/etc/nginx/servers'

mkdir -p "${servers_dir}"
rm -f "${servers_dir}"/*.conf

# The root comes from the file Tautulli reads it from, which init-tautulli has
# already brought up to date, so the two cannot disagree.
base_url=''
if [[ -s "${config_file}" ]]; then
  base_url="$(PYTHONPATH=/opt/tautulli/lib python3 - "${config_file}" <<'EOF'
import sys

from configobj import ConfigObj

config = ConfigObj(sys.argv[1], encoding='utf-8')
http_root = str(config.get('General', {}).get('http_root', '')).strip('/')
print('/' + http_root if http_root else '')
EOF
)" || base_url=''
fi

# Supervisor gives the hassio network IPv6 addresses on some installs and not
# others, and nginx will not start on an address family the container lacks.
# The kernel lists the container's IPv6 addresses in /proc/net/if_inet6, and
# the file is read rather than tested for size, since every file under /proc
# reports a size of 0.
listen_ipv6=''
if grep -q . /proc/net/if_inet6 2>/dev/null; then
  listen_ipv6='listen [::]:8181 default_server;'
fi

# With no root, everything goes to Tautulli as it came.
maps=''
if [[ -n "${base_url}" ]]; then
  # The root each caller sees: the ingress path through ingress, and none on
  # the published port. A redirect to the bare root needs a path of its own,
  # since an empty one would leave the browser where it was.
  maps="
map \$from_ingress \$public_base {
    1 ${base_url};
    0 '';
}

map \$from_ingress \$public_root {
    1 ${base_url}/;
    0 /;
}

map \$from_ingress \$ingress_cookie_path {
    1 ${base_url};
    0 /;
}

map \$request_uri \$request_uri_without_base {
    default \$request_uri;
    \"~^${base_url}(?<rest>/.*)\$\" \$rest;
    \"~^${base_url}(?<rest>\\?.*)?\$\" /\$rest;
}
"
  # Tautulli writes its root into its pages and the scripts inside them, and
  # into its redirects, and names it nowhere else: its own scripts and styles
  # use addresses relative to the page. So replacing that one string is all it
  # takes. Through ingress the replacement is the path itself, which changes
  # nothing.
  #
  # Tautulli's redirects are absolute, and name the host it was asked for,
  # which through ingress is this container rather than Home Assistant, so the
  # host is dropped and the browser stays where it is.
  #
  # Its sign-in cookie is set for the root, which on the published port becomes
  # /. Its session cookie is set for /, which through ingress is Home
  # Assistant's, shared by every ingress application, so there it is scoped to
  # the ingress path instead.
  locations="
    proxy_set_header Accept-Encoding \$upstream_accept_encoding;
    sub_filter '${base_url}' '\$public_base';
    sub_filter_once off;
    sub_filter_types application/javascript application/json text/css text/javascript;
    gzip on;
    gzip_proxied any;
    gzip_types application/javascript application/json text/css text/javascript text/plain;
    gzip_vary on;
    proxy_redirect ~^(https?://[^/]+)?${base_url}(/.*)\$ \$public_base\$2;
    proxy_redirect ~^(https?://[^/]+)?${base_url}\$ \$public_root;
    proxy_cookie_path ~^${base_url}/?\$ \$public_root;
    proxy_cookie_path ~^/\$ \$ingress_cookie_path;

    location ^~ ${base_url} {
        if (\$redirect_out_of_base) {
            return 307 \$request_uri_without_base;
        }

        proxy_pass http://127.0.0.1:18181;
    }

    location / {
        proxy_pass http://127.0.0.1:18181${base_url}\$request_uri;
    }"
else
  locations='
    location / {
        proxy_pass http://127.0.0.1:18181;
    }'
fi

cat > "${servers_dir}/tautulli.conf" <<EOF
${maps}
server {
    listen 8181 default_server;
    ${listen_ipv6}

    include /etc/nginx/includes/proxy.conf;
${locations}
}
EOF

exec nginx
