#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Bazarr
# Runs Bazarr
# ==============================================================================

bashio::log.info 'Starting Bazarr...'

# --port moves Bazarr off 6767, where nginx answers in its place, and wins over
# general.port in config.yaml. Bazarr passes it on when it restarts itself.
exec python3 /opt/bin/bazarr.py --no-update --config /config --port 16767
