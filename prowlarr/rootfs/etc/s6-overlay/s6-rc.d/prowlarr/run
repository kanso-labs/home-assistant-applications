#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Prowlarr
# Runs Prowlarr
# ==============================================================================

# Prowlarr tries IPv6 before IPv4 whenever the host has IPv6. Behind Cloudflare
# that has been seen to fail: the retry Prowlarr sends with the cookies
# FlareSolverr or Byparr just earned is challenged again over IPv6, while the
# same retry over IPv4 gets through. .NET stops using IPv6 for the whole
# process when this variable is 1, which also turns Prowlarr's IPv6-first
# connection logic off.
if bashio::config.true 'ipv4_only'; then
  export DOTNET_SYSTEM_NET_DISABLEIPV6=1
  bashio::log.info 'Connecting over IPv4 only'
fi

# Ingress serves Prowlarr under a path Supervisor chooses, and Prowlarr writes one
# URL base into every page it serves. So the ingress path is that base, and
# nginx answers on 9696 in Prowlarr's place, adding the path to whatever arrives
# without it. The Dockerfile keeps Prowlarr itself on the loopback address. These
# variables win over config.xml without rewriting it, so whatever URL base is
# saved there comes back if the application ever runs without them.
ingress_entry="$(bashio::app.ingress_entry)"
if ! bashio::var.has_value "${ingress_entry}" || [[ "${ingress_entry}" == 'null' ]]; then
  ingress_entry=''
fi
export Prowlarr__Server__UrlBase="${ingress_entry%/}"

# A URL base saved before ingress, /prowlarr say, is one nothing answers under
# any more: whatever still calls Prowlarr there gets its web page or a 404 in
# place of an answer. An ingress path is passed over: Prowlarr writes the base
# to config.xml only when it is changed under Settings, never the one these
# variables give it, so one is there only if it was typed in, and nothing
# outside Home Assistant calls it.
saved_url_base="$(xmlstarlet sel -t -v '/Config/UrlBase' /config/config.xml 2>/dev/null || true)"
saved_url_base="${saved_url_base#/}"
saved_url_base="${saved_url_base%/}"
if [[ -n "${saved_url_base}" && "${saved_url_base}" != api/hassio_ingress/* ]]; then
  bashio::log.warning "The URL Base /${saved_url_base} saved in config.xml is ignored. Prowlarr answers at the root of port 9696, so anything calling http://<host>:9696/${saved_url_base} has to call http://<host>:9696 instead. Saving Settings → General on the published port clears it."
fi

bashio::log.info 'Starting Prowlarr...'

exec /opt/bin/Prowlarr -nobrowser -data=/config
