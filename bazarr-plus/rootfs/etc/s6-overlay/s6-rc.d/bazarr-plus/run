#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Bazarr+
# Runs Bazarr+
# ==============================================================================

# The image sets this to /config, and Bazarr writes there for anything it
# resolves against the home directory rather than against --config.
export HOME='/config'

bashio::log.info 'Starting Bazarr+...'

cd /app/bazarr || bashio::exit.nok 'The application directory is missing'

# The same command the image's own entrypoint ends on, minus the privilege
# drop. --no-update is upstream's switch for a container-managed install: the
# interface will report a newer version and refuse to install it, which is what
# makes this packaging the only route to one.
exec python docker/supervisor.py --no-update --config /config
