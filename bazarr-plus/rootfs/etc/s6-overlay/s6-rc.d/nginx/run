#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Bazarr+
# Runs nginx, which answers on 6767 for Bazarr+, puts its URL base back onto
# requests that arrive without it, and takes it out of what goes back to the
# published port
# ==============================================================================
readonly config_file='/config/config/config.yaml'
readonly servers_dir='/etc/nginx/servers'

mkdir -p "${servers_dir}"
rm -f "${servers_dir}"/*.conf

# The base comes from the file Bazarr+ reads it from, which init-bazarr-plus has
# already brought up to date, so the two cannot disagree.
base_url=''
if [[ -s "${config_file}" ]]; then
  base_url="$(python - "${config_file}" <<'EOF'
import sys

import yaml

with open(sys.argv[1]) as f:
    config = yaml.safe_load(f) or {}
print(((config.get('general') or {}).get('base_url') or '').rstrip('/'))
EOF
)" || base_url=''
fi

# Supervisor gives the hassio network IPv6 addresses on some installs and not
# others, and nginx will not start on an address family the container lacks.
# The kernel lists the container's IPv6 addresses in /proc/net/if_inet6, and
# the file is read rather than tested for size, since every file under /proc
# reports a size of 0.
listen_ipv6=''
if grep -q . /proc/net/if_inet6 2>/dev/null; then
  listen_ipv6='listen [::]:6767 default_server;'
fi

# The image carries no tempio, unlike Home Assistant's base images, so the
# server is written here. With no base, everything goes to Bazarr+ as it came.
maps=''
if [[ -n "${base_url}" ]]; then
  # The base each caller sees: the ingress path through ingress, and none on
  # the published port. A redirect to the bare base needs a path of its own,
  # since an empty one would leave the browser where it was.
  maps="
map \$from_ingress \$public_base {
    1 ${base_url};
    0 '';
}

map \$from_ingress \$public_root {
    1 ${base_url};
    0 /;
}

map \$from_ingress \$ingress_cookie_path {
    1 ${base_url};
    0 /;
}

map \$request_uri \$request_uri_without_base {
    default \$request_uri;
    \"~^${base_url}(?<rest>/.*)\$\" \$rest;
    \"~^${base_url}(?<rest>\\?.*)?\$\" /\$rest;
}
"
  # Bazarr+ writes its base into the page's <base> and the settings it injects
  # there, the API's answers, and its redirects, and names it nowhere else: the
  # scripts read it from the page. So replacing that one string is all it
  # takes. Through ingress the replacement is the path itself, which changes
  # nothing. Its session cookie is set for the root, which through ingress is
  # Home Assistant's, shared by every ingress application, and Notifiarr's and
  # Bazarr's session cookies have the same name, so there it is scoped to the
  # ingress path instead.
  locations="
    proxy_set_header Accept-Encoding \$upstream_accept_encoding;
    sub_filter '${base_url}' '\$public_base';
    sub_filter_once off;
    sub_filter_types application/javascript application/json application/manifest+json text/css text/javascript;
    proxy_redirect ~^(https?://[^/]+)?${base_url}(/.*)\$ \$1\$public_base\$2;
    proxy_redirect ~^(https?://[^/]+)?${base_url}\$ \$1\$public_root;
    proxy_cookie_path ~^/\$ \$ingress_cookie_path;

    location ^~ ${base_url} {
        if (\$redirect_out_of_base) {
            return 307 \$request_uri_without_base;
        }

        proxy_pass http://127.0.0.1:16767;
    }

    location / {
        proxy_pass http://127.0.0.1:16767${base_url}\$request_uri;
    }"
else
  locations='
    location / {
        proxy_pass http://127.0.0.1:16767;
    }'
fi

cat > "${servers_dir}/bazarr-plus.conf" <<EOF
${maps}
server {
    listen 6767 default_server;
    ${listen_ipv6}

    include /etc/nginx/includes/proxy.conf;
${locations}
}
EOF

exec nginx
