#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Profilarr
# Runs Profilarr
# ==============================================================================

# The image already points APP_BASE_PATH at /config, which is where Supervisor
# mounts the application's configuration directory, so nothing has to move.
# Profilarr creates the directories it uses itself, its database included under
# data. These are the ones the entrypoint this service replaces made, kept so an
# install that already has them sees no change.
mkdir -p \
  /config/backups \
  /config/data \
  /config/databases \
  /config/logs

# The image creates a profilarr user, uid 1000 with /config as its home, and
# upstream's entrypoint runs Profilarr as that user. s6-overlay has to be pid 1
# here, so the service starts as root and drops to it at the end. Whatever in
# /config the user does not own, as on an install that ran Profilarr as root,
# is handed to it first, since git refuses a clone another user owns.
if [[ -n "$(find /config \( ! -user profilarr -o ! -group profilarr \) -print -quit)" ]]; then
  bashio::log.info 'Giving /config to the profilarr user...'
  chown -R profilarr:profilarr /config \
    || bashio::exit.nok 'Could not give /config to the profilarr user'
fi

# Profilarr's own login. It is on by default, which is the right answer for a
# port published on your network; turning it off is for a network where you
# would rather not have a second password than a media stack. Only an explicit
# false turns it off: bashio reads an option it could not fetch from Supervisor
# as empty, and an empty value has to keep the login on rather than drop it.
if bashio::config.false 'enable_authentication'; then
  export AUTH='off'
  bashio::log.warning \
    'Authentication is disabled — anyone who can reach port 6868 can use Profilarr.'
else
  export AUTH='on'
fi

# The public address, for when a reverse proxy is in front of this
# application. Profilarr refuses any form, its login included, sent from a page
# at an address other than the one the request arrived at, and behind a proxy
# that serves https://, or that rewrites the host, the two differ. Set, it
# stands in for the address of every request, which is also why the published
# port then refuses the login. Profilarr marks its session cookie secure when
# this starts with https://. Left unset, each request keeps the address it
# arrived at.
if bashio::config.has_value 'external_url'; then
  ORIGIN=$(bashio::config 'external_url')
  export ORIGIN
fi

# The parser is a separate service upstream ships as its own image, and it is
# what the custom format and quality profile testing pages call. A Home
# Assistant application is one container, so there is none here; set this to
# one running elsewhere to turn those pages on. Everything else works without.
if bashio::config.has_value 'parser_host'; then
  PARSER_HOST=$(bashio::config 'parser_host')
  PARSER_PORT=$(bashio::config 'parser_port')
  export PARSER_HOST PARSER_PORT
  bashio::log.info "Using the parser at ${PARSER_HOST}:${PARSER_PORT}."
fi

bashio::log.info 'Starting Profilarr...'

# s6-setuidgid changes the user without changing the home directory. Left at
# /root, which the profilarr user cannot read, it has git warn on every command
# Profilarr runs. Upstream's entrypoint leaves it at the user's own, /config.
export HOME='/config'

exec s6-setuidgid profilarr /app/profilarr
