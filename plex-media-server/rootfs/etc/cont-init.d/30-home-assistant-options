#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Plex Media Server
# Passes the application's options to Plex
# ==============================================================================

# Plex's own start-up scripts read their settings from the container
# environment, and run after this one. Writing the value here is what puts it
# in front of them, since exporting a variable would not outlive this script.
readonly environment='/var/run/s6/container_environment'

if bashio::config.has_value 'claim_code'; then
  bashio::log.info 'Claiming this server with the code from the options...'
  printf '%s' "$(bashio::config 'claim_code')" > "${environment}/PLEX_CLAIM"
else
  bashio::log.notice 'No claim code set. The server will start unclaimed.'
  bashio::log.notice 'Get one from https://plex.tv/claim, put it in the'
  bashio::log.notice 'application options, and restart. A code expires four'
  bashio::log.notice 'minutes after it is issued.'
fi

# Plex decides a client is on the local network by comparing its address
# against the server's own. This one only ever sees the address Home Assistant
# gave the container, so every browser on the real network looks remote to it
# and is refused. These entries are the addresses it treats as local anyway.
if bashio::config.has_value 'allowed_networks'; then
  networks=''
  for network in $(bashio::config 'allowed_networks'); do
    networks="${networks:+${networks},}${network}"
  done

  bashio::log.info "Networks allowed without signing in: ${networks}"
  printf '%s' "${networks}" > "${environment}/ALLOWED_NETWORKS"
fi

# Plex publishes the addresses it finds on itself to plex.tv, and an app picks
# one of them to play from. The only address it finds here is the one Home
# Assistant gave the container, on a network nothing outside the machine can
# route to, and an app that picks that one reaches nothing. Apps differ in how
# they take that: a browser drops it and moves on, while several television
# apps do not, and fail to play from a server they can otherwise browse. These
# entries are published alongside it, so there is an address worth picking.
if bashio::config.has_value 'advertise_addresses'; then
  addresses=''
  for address in $(bashio::config 'advertise_addresses'); do
    addresses="${addresses:+${addresses},}${address}"
  done

  bashio::log.info "Addresses advertised to apps: ${addresses}"
  printf '%s' "${addresses}" > "${environment}/ADVERTISE_IP"
fi
