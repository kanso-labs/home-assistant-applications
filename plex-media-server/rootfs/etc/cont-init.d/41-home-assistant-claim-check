#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Plex Media Server
# Reports whether anything can reach this server
# ==============================================================================
#
# Plex exchanges the claim code in the script that runs before this one, and
# reports neither success nor failure. A code lasts four minutes, so a failed
# exchange is an ordinary outcome rather than a rare one, and a server nothing
# can reach is indistinguishable from a working one until someone opens it.

# shellcheck source=/dev/null
[ -f /etc/default/plexmediaserver ] && . /etc/default/plexmediaserver
support="${PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR:-/config/Library/Application Support}"
readonly preferences="${support}/Plex Media Server/Preferences.xml"

if ! bashio::fs.file_exists "${preferences}"; then
  bashio::log.warning 'Plex has not written its settings yet, so whether this'
  bashio::log.warning 'server can be reached cannot be reported.'
  exit 0
fi

function preference() {
  xmlstarlet sel -T -t -m '/Preferences' -v "@${1}" -n "${preferences}"
}

token="$(preference 'PlexOnlineToken')"
allowed="$(preference 'allowedNetworks')"

# Reported on its own, because an allowed network hides the consequence of the
# claim failing without making the claim any more likely to have worked.
if bashio::config.has_value 'claim_code' && ! bashio::var.has_value "${token}"; then
  bashio::log.error 'The claim code did not work, so this server is unclaimed.'
  bashio::log.error 'Codes last four minutes, and one that has been used or has'
  bashio::log.error 'expired is refused. Take a fresh one from'
  bashio::log.error 'https://plex.tv/claim and restart straight away.'
fi

if bashio::var.has_value "${token}"; then
  bashio::log.info 'This server is claimed. Sign in with the Plex account it'
  bashio::log.info 'was claimed with to reach it.'
  exit 0
fi

if bashio::var.has_value "${allowed}"; then
  bashio::log.info "This server is unclaimed, and open to ${allowed} without"
  bashio::log.info 'signing in. Reach it by the address of this machine, since'
  bashio::log.info 'Plex refuses a host name it does not recognise as its own.'
  exit 0
fi

bashio::log.error 'This server is unclaimed and allows no network, so nothing'
bashio::log.error 'can reach it.'

if ! bashio::config.has_value 'claim_code'; then
  bashio::log.error 'Take a claim code from https://plex.tv/claim, put it in'
  bashio::log.error 'claim_code, and restart within four minutes. Setting'
  bashio::log.error 'allowed_networks instead works without a Plex account.'
fi
