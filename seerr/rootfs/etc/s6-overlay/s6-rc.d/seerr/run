#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Seerr
# Runs Seerr
# ==============================================================================

readonly config_dir='/config'

# Seerr keeps its settings and database beside the application by default,
# which an update would discard. Pointing it at the configuration directory
# is what makes both survive.
export CONFIG_DIRECTORY="${config_dir}"

# A file named DOCKER in the configuration directory is how Seerr detects a
# missing volume: upstream bakes one into its image, so that mounting a volume
# over the directory hides it. While it is present, the setup wizard warns that
# all data will be cleared on restart. /config is always mapped here, so there
# must be no marker, and removing it also clears the one that earlier versions
# of this application created by mistake.
rm -f "${config_dir}/DOCKER"

bashio::log.info 'Starting Seerr...'

cd /app || bashio::exit.nok 'The application directory is missing'

exec npm start
