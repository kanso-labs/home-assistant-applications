#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: n8n
# Runs n8n
# ==============================================================================

# Anything from env_vars goes in first, so every variable set below wins when the
# two disagree. NODE_ENV comes from the image and stays production. Names are
# logged and values never are, because passwords and API keys end up here.
for index in $(bashio::config 'env_vars|keys'); do
  name=$(bashio::config "env_vars[${index}].name")
  if [[ "${name}" == "NODE_ENV" ]]; then
    bashio::log.warning 'Ignoring NODE_ENV from env_vars; n8n runs in production mode here'
    continue
  fi
  value=$(bashio::config "env_vars[${index}].value")
  export "${name}=${value}"
  bashio::log.info "Setting ${name} from env_vars"
done

# Ingress and the published port both reach n8n here. It listens on every
# address by default, so nothing needs N8N_HOST, which only names the host in
# the addresses n8n shows.
export N8N_PORT=5678

# Ensure data persistence
export N8N_USER_FOLDER=/data

# Supervisor appends to X-Forwarded-For on every ingress request, and n8n's rate
# limiter logs a ValidationError for that header unless one proxy hop is
# trusted. A client calling a published port directly could then forge the
# address the per-IP limit counts, but the login limit that stops a password
# guess is keyed on the email, not the address.
export N8N_PROXY_HOPS=1

# n8n confines the Read/Write Files from Disk node to this list, and without it
# to ~/.n8n-files, which is inside the container and gone on the next start.
# /share is mapped for workflows to read from, so it is the list.
export N8N_RESTRICT_FILE_ACCESS_TO=/share

# Setup integration with Home Assistant
GENERIC_TIMEZONE=$(bashio::info.timezone)
N8N_LOG_LEVEL=$(bashio::config 'log_level')
N8N_PATH="$(bashio::addon.ingress_entry | sed 's|/*$|/|')"
N8N_SECURE_COOKIE=$(bashio::config 'enable_ssl')
export GENERIC_TIMEZONE N8N_LOG_LEVEL N8N_PATH N8N_SECURE_COOKIE

# n8n builds every address it hands out, OAuth callbacks included, from its
# editor base URL, falling back to its webhook URL. An OAuth provider needs an
# absolute address, and its redirect back cannot come through ingress, because
# the Home Assistant frontend sets the ingress session cookie SameSite=Strict.
# So with webhook_url set, it is the base for everything. Without it, the
# ingress path at least resolves for links opened from the editor.
if bashio::config.has_value 'webhook_url'; then
  N8N_WEBHOOK_URL=$(bashio::config 'webhook_url')
  export N8N_WEBHOOK_URL
else
  N8N_EDITOR_BASE_URL=$(bashio::addon.ingress_url)
  export N8N_EDITOR_BASE_URL
fi

# Home Assistant shares the internal network with this application, so an
# automation can call a webhook here with no port published, by the hostname
# Supervisor registers for it.
internal_host=$(bashio::addon.hostname)
bashio::log.info "Home Assistant can call webhooks at http://${internal_host}:${N8N_PORT}/webhook/..."

EXT_MODULES=""
for package in $(bashio::config 'node_function_external_modules'); do
    EXT_MODULES="${EXT_MODULES}${package},"
done
export NODE_FUNCTION_ALLOW_EXTERNAL=${EXT_MODULES%,}

# This caps n8n's own heap. Code nodes run in a separate runner, which reads
# N8N_RUNNERS_MAX_OLD_SPACE_SIZE instead, and env_vars can set that.
if bashio::config.has_value 'max_old_space_size'; then
  max_old_space_size=$(bashio::config 'max_old_space_size')
  export NODE_OPTIONS="${NODE_OPTIONS:+${NODE_OPTIONS} }--max-old-space-size=${max_old_space_size}"
fi

bashio::log.info 'Starting n8n...'

cd /usr/src/n8n || bashio::exit.nok 'Could not enter the n8n install directory'
export PATH="/root/.local/share/mise/shims:${PATH}"
exec ./node_modules/.bin/n8n start
