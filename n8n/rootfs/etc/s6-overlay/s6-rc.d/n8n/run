#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: n8n
# Runs n8n
# ==============================================================================

# Expose n8n locally
export N8N_PORT=5678
export N8N_HOST=0.0.0.0

# Ensure data persistence
export N8N_USER_FOLDER=/data

# Setup integration with Home Assistant
GENERIC_TIMEZONE=$(bashio::info.timezone)
N8N_EDITOR_BASE_URL=$(bashio::addon.ingress_url)
N8N_LOG_LEVEL=$(bashio::config 'log_level')
N8N_PATH="$(bashio::addon.ingress_entry | sed 's|/*$|/|')"
N8N_RUNNERS_ENABLED=$(bashio::config 'enable_task_runners')
N8N_SECURE_COOKIE=$(bashio::config 'enable_ssl')
export GENERIC_TIMEZONE N8N_EDITOR_BASE_URL N8N_LOG_LEVEL N8N_PATH
export N8N_RUNNERS_ENABLED N8N_SECURE_COOKIE

# n8n derives the URL it shows for production webhooks from N8N_HOST and
# N8N_PORT, which are the bind address here — so without this it advertises
# http://0.0.0.0:5678/, which nothing can reach. Set webhook_url to whatever
# address actually routes to this application from outside.
if bashio::config.has_value 'webhook_url'; then
  N8N_WEBHOOK_URL=$(bashio::config 'webhook_url')
  export N8N_WEBHOOK_URL
fi

EXT_MODULES=""
for package in $(bashio::config 'node_function_external_modules'); do
    EXT_MODULES="${EXT_MODULES}${package},"
done
export NODE_FUNCTION_ALLOW_EXTERNAL=${EXT_MODULES%,}

bashio::log.info 'Starting n8n...'

cd /usr/src/n8n || bashio::exit.nok 'Could not enter the n8n install directory'
export PATH="/root/.local/share/mise/shims:${PATH}"
exec ./node_modules/.bin/n8n start
