#!/usr/bin/env bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: n8n
# Puts the Home Assistant, MQTT and MariaDB credentials into n8n
#
# Run by the n8n service just before n8n starts, with the environment n8n gets,
# so the import reaches the same database and encrypts with the same key.
# ==============================================================================
readonly seed_file='/data/.home-assistant-credentials.sha256'
declare -a credentials=()

# Whether an application on this Home Assistant provides the service. Supervisor
# answers with an error for a service nothing provides, which bashio would log
# as one on every start for anyone without a broker or a database.
service_installed() {
  (
    bashio::log.level 'fatal'
    bashio::services.available "${1}"
  )
}

# The credentials go in through n8n's own import command, encrypted with the
# instance key like any other. Each has a fixed id, so a later import updates
# it in place rather than adding a second one.

# Home Assistant. The node wants a host, a port and a long-lived access token.
# It gets the stand-in nginx serves on the loopback address, which adds this
# application's Supervisor token itself, so the token here is a placeholder
# nothing reads.
if bashio::config.true 'home_assistant_credential'; then
  credentials+=("$(bashio::var.json \
    id 'HomeAssistantApp' \
    name 'Home Assistant' \
    type 'homeAssistantApi' \
    data "^$(bashio::var.json \
      host '127.0.0.1' \
      port '^48123' \
      ssl '^false' \
      accessToken 'managed-by-this-application')")")
fi

# MQTT, when a broker on this Home Assistant announces itself through
# Supervisor, as the Mosquitto broker does.
if bashio::config.true 'mqtt_credential'; then
  if service_installed 'mqtt'; then
    ssl=$(bashio::services 'mqtt' 'ssl')
    protocol='mqtt'
    if bashio::var.true "${ssl}"; then
      protocol='mqtts'
    fi

    credentials+=("$(bashio::var.json \
      id 'HomeAssistantMqtt' \
      name 'MQTT (Home Assistant)' \
      type 'mqtt' \
      data "^$(bashio::var.json \
        protocol "${protocol}" \
        host "$(bashio::services 'mqtt' 'host')" \
        port "^$(bashio::services 'mqtt' 'port')" \
        username "$(bashio::services 'mqtt' 'username')" \
        password "$(bashio::services 'mqtt' 'password')" \
        clean '^true' \
        clientId '' \
        ssl "^${ssl}" \
        passwordless '^false' \
        ca '' \
        cert '' \
        key '' \
        rejectUnauthorized '^false')")")
  else
    bashio::log.info 'No MQTT broker is installed, so there is no MQTT credential to make'
  fi
fi

# MariaDB, when the MariaDB application announces itself. The credential opens
# the mysql schema, which its login can always see; a query names the schema it
# wants, as in homeassistant.states.
if bashio::config.true 'mariadb_credential'; then
  if service_installed 'mysql'; then
    credentials+=("$(bashio::var.json \
      id 'HomeAssistantMariaDb' \
      name 'MariaDB (Home Assistant)' \
      type 'mySql' \
      data "^$(bashio::var.json \
        host "$(bashio::services 'mysql' 'host')" \
        database 'mysql' \
        user "$(bashio::services 'mysql' 'username')" \
        password "$(bashio::services 'mysql' 'password')" \
        port "^$(bashio::services 'mysql' 'port')" \
        connectTimeout '^10000' \
        ssl '^false' \
        caCertificate '' \
        clientPrivateKey '' \
        clientCertificate '')")")
  else
    bashio::log.info 'No MariaDB is installed, so there is no MariaDB credential to make'
  fi
fi

if [[ ${#credentials[@]} -eq 0 ]]; then
  exit 0
fi

seed=$(printf '%s\n' "${credentials[@]}" | jq -s '.')
digest=$(sha256sum <<< "${seed}")

# The import starts most of n8n, so an unchanged set is not imported again. The
# file holds a digest, never the passwords it was taken from.
if [[ -f "${seed_file}" && "$(<"${seed_file}")" == "${digest}" ]]; then
  bashio::log.info 'The Home Assistant credentials in n8n are up to date'
  exit 0
fi

bashio::log.info 'Putting the Home Assistant credentials into n8n...'

input=$(mktemp)
trap 'rm -f "${input}"' EXIT
printf '%s' "${seed}" > "${input}"

/usr/src/n8n/node_modules/.bin/n8n import:credentials --input="${input}"

printf '%s' "${digest}" > "${seed_file}"
