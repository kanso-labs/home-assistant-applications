#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Jackett
# Runs Jackett
# ==============================================================================

bashio::log.info 'Starting Jackett...'

# Jackett updates itself in place by default, replacing the binary this image
# provides with one that is discarded on the next update of the application.
# Updates arrive by rebuilding the image instead.
#
# The data folder is not passed here. Jackett's own help says not to use
# --DataFolder on Unix, so the Dockerfile sets XDG_CONFIG_HOME instead.
exec /opt/bin/jackett \
  --NoRestart \
  --NoUpdates
