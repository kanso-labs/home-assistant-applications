#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Kanso Labs Home Assistant Application: Avahi Publisher
# Publishes the aliases
# ==============================================================================
readonly aliases='/run/avahi-publisher/aliases'

# Publishes one alias, and publishes it again five minutes after each time it
# stops. avahi-publish cannot pick another name for a .local alias: when another
# device already answers for the name with a different address, it aborts
# instead, and starting it again at once would only announce the conflict again
# every second. Its child runs in the background and is waited for, because bash
# acts on TERM only once a foreground command has ended.
publish() {
  local name="${1}" address="${2}" child=''
  trap 'kill "${child}" 2> /dev/null || true; exit 0' TERM

  while true; do
    # --no-reverse, because every alias for this host shares its address, and
    # each reverse record would claim that address for a different name.
    # --no-fail keeps avahi-publish waiting through an Avahi restart and
    # publishing again afterwards, rather than exiting.
    avahi-publish --address --no-reverse --no-fail "${name}" "${address}" &
    child="$!"
    wait "${child}" || true

    bashio::log.warning "${name} stopped publishing, and is published again in five minutes. If the lines above report a name collision, another device already answers for ${name} with a different address: rename the alias, or correct its address."
    sleep 300 &
    child="$!"
    wait "${child}" || true
  done
}

# s6 stops this service with TERM, which ends the wait below early. Each alias
# then stops its own avahi-publish, and the exit keeps a stop from reading as a
# failure.
pids=()
trap 'kill "${pids[@]}" 2> /dev/null || true; exit 0' TERM

while IFS=$'\t' read -r name address; do
  if [[ -z "${address}" ]]; then
    bashio::log.warning "Not publishing ${name}: it has no address, and this host has no IPv4 address to give it"
    continue
  fi

  bashio::log.info "Publishing ${name} at ${address}"
  publish "${name}" "${address}" &
  pids+=("$!")
done < "${aliases}"

# s6 restarts a service that exits, so with nothing to publish this one stays up
# and does nothing.
if [[ ${#pids[@]} -eq 0 ]]; then
  exec sleep infinity
fi

# Every alias publishes on its own until the service is stopped, so one that
# cannot be published never takes the others down with it.
wait "${pids[@]}" || true
